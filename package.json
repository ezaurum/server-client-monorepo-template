{
  "name": "templateapp",
  "private": true,
  "scripts": {
    "client:dev": "pnpm --filter @templateapp/client dev",
    "client:build": "pnpm --filter @templateapp/client build",
    "client:test": "pnpm --filter @templateapp/client test",
    "lint:script": "eslint",
    "lint:style": "stylelint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "vue-demi"
    ]
  },
  "lint-staged": {
    "**/*.{ts,vue,js,tsx,jsx}": "pnpm lint:script --fix",
    "**/*.{css,scss,vue}": "pnpm lint:style --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "globals": "^15.15.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-vue": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "stylelint": "^16.18.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-prettier": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "typescript-eslint": "^8.29.1"
  }
}
